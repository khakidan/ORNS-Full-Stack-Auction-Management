# GEMINI_MODEL: The Gemini model ID to use (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# GOOGLE_SCRIPT_ID: The ID of your Google Apps Script project (from Project Settings)
GOOGLE_SCRIPT_ID=
