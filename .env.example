# Local development settings. Copy this file to .env (gitignored) and
# fill it in - server/env.ts loads it at boot. Production does not use
# this file: the deployed Cloud Run service has these set as its own
# environment variables. See docs/agents/README.md "Running Locally".

# GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth Client ID
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Your Google Cloud Console OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# The auction's spreadsheet and folder IDs, ticket price and PayPal mode are
# not set here: they live in Firestore settings/global and are edited on the
# Settings page (server/services/configService.ts).
SCRIPT_ID_ITEM_ENTRY=
SCRIPT_ID_TICKETS=
SCRIPT_ID_BID_MANAGEMENT=
# Apps Script calls run each script's deployed API-executable version.
# "true" runs the editor's latest saved code instead - only for the
# script's owner, and only for trying .gs edits before deploying them.
APPS_SCRIPT_DEV_MODE="false"
DRIVE_PARENT_FOLDER_ID=
DRIVE_ARCHIVE_FOLDER_ID=
# Auction/General Auction Info/Template Files - where the master Action
# History spreadsheet is created, next to the master Bid Management and
# Item Entry spreadsheets.
DRIVE_TEMPLATE_FILES_FOLDER_ID=

# Template document file IDs
TEMPLATE_VOLUNTEER_BUSINESS_FOLLOWUP_FAQS_ID=
TEMPLATE_VOLUNTEER_EMAIL_SCRIPT_AND_TALKING_POINTS_ID=
TEMPLATE_NIGHT_OF_AUCTION_VOLUNTEERS_ID=
TEMPLATE_REPEAT_DONOR_LETTER_ID=
TEMPLATE_NEW_DONOR_LETTER_ID=
TEMPLATE_DONATION_FORM_ID=
TEMPLATE_PROJECT_MANAGEMENT_TEMPLATE_ID=
TEMPLATE_INITIAL_PLANNING_MEETING_ID=

# SESSION_SECRET: A secret key for session management
SESSION_SECRET=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# GEMINI_MODEL: The Gemini model ID to use (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# FULL_ADMIN_EMAILS: Comma-separated @orns.org addresses that are always
# Full Administrators (can open Settings and manage roles). Set at least one.
FULL_ADMIN_EMAILS=

# VOLUNTEER_GOOGLE_ACCOUNT: The shared account volunteers run as; it can't
# sign in to the app itself.
VOLUNTEER_GOOGLE_ACCOUNT="auction-volunteers@orns.org"

# APP_URL: The URL this server is reached at - http://localhost:<PORT> locally.
# The OAuth client must list <APP_URL>/auth/callback as an Authorized
# redirect URI.
APP_URL="http://localhost:3000"

# PayPal REST app credentials - both apps, so Settings > PayPal Integration's
# sandbox/live switch is all it takes to change PayPal. PAYPAL_* is the live
# app ("Auction AI Receipts"), SANDBOX_PAYPAL_* the sandbox app ("Auction
# Sandbox Test"). A mode whose pair is empty fails clearly - it never uses
# the other pair. Locally, the sandbox pair is enough. PAYPAL_IS_SANDBOX is
# only the fallback when nothing passes the Settings switch.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SANDBOX_PAYPAL_CLIENT_ID=
SANDBOX_PAYPAL_CLIENT_SECRET=
PAYPAL_IS_SANDBOX="true"

# SWEEPER_TRIGGER_SECRET: shared secret Cloud Scheduler sends (header
# X-Sweeper-Secret) to POST /internal/paypal-sweep, which runs the
# background PayPal invoice-status sweep. Production only - leave it
# empty locally, so a local server never sweeps the live Bidder-Numbers
# sheet on its own (the in-app "Run Sweep Now" button still works).
SWEEPER_TRIGGER_SECRET=

# FLUENT_FORMS_WEBHOOK_SECRET: shared secret the Auction Tickets form's
# Webhook feed sends (header X-ORNS-Webhook-Secret) to
# POST /api/webhooks/fluent-forms/tickets. Production only - leave it
# empty locally, which turns that endpoint off.
FLUENT_FORMS_WEBHOOK_SECRET=
# FLUENT_FORMS_TICKETS_MODE: "write" makes that webhook add ticket rows.
# Leave it empty (shadow mode: report, write nothing) until the
# switch-over, when the form's Google Sheets feed is turned off.
FLUENT_FORMS_TICKETS_MODE=
# FLUENT_FORMS_SITE_URL / _API_USER / _API_PASSWORD: WordPress's REST API,
# signed in as a dedicated user with an Application Password - how the
# ticket webhook confirms a PayPal payment (ROADMAP W4). Any one empty
# turns the payment check off. FLUENT_FORMS_TICKETS_FORM_ID defaults to 7.
FLUENT_FORMS_SITE_URL=
FLUENT_FORMS_API_USER=
FLUENT_FORMS_API_PASSWORD=
FLUENT_FORMS_TICKETS_FORM_ID=

# GOOGLE_APPLICATION_CREDENTIALS: needed ONLY for local development, so
# firebase-admin (server/services/firebaseAdmin.ts, used only by the
# PayPal sweeper background job) can authenticate to Firestore. Not
# needed when deployed to Google Cloud (Cloud Run, etc.) - Application
# Default Credentials resolve automatically from the attached service
# account there. Optional for local dev too: leaving this unset doesn't
# break login or normal app use - it just means the sweeper's
# credential-persist step logs an error and the background sweep no-ops
# on your machine.
#
# Easiest local setup - no key file needed, leave this var blank:
#   1. Install the gcloud CLI.
#   2. Run: gcloud auth application-default login
#   3. Sign in with a Google account that has access to the
#      "orns-auction-bid-management" Firebase project (see
#      firebase-applet-config.json's projectId).
#
# Alternative - a downloaded service account key (only if you'd rather
# not use gcloud): Firebase console -> orns-auction-bid-management ->
# Project settings (gear icon) -> Service accounts tab -> Generate new
# private key. Save the downloaded .json OUTSIDE this repo (never commit
# it) and set this var to its full path.
GOOGLE_APPLICATION_CREDENTIALS=

# PORT: The local port the Express server binds to. Defaults to 3000 if unset
# (Cloud Run sets this automatically in deployed environments - only needed
# for local dev when 3000 is already taken by another app).
PORT=3000
