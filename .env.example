# GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth Client ID
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Your Google Cloud Console OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# Application Config (for local development fallback)
VITE_AUCTION_ITEMS_SPREADSHEET_ID=
VITE_AUCTION_TICKETS_SPREADSHEET_ID=
VITE_BID_MANAGEMENT_SPREADSHEET_ID=
VITE_AUCTION_ITEMS_SCRIPT_ID=
VITE_AUCTION_TICKETS_SCRIPT_ID=
VITE_BID_MANAGEMENT_SCRIPT_ID=
VITE_BIDDER_NUMBERS_SHEET="Bidder-Numbers"
VITE_AUCTION_ITEMS_SHEET="Auction-Items"
VITE_BID_MANAGEMENT_SHEET="Bid-Management"
VITE_RECEIPT_FOLDER_ID=
VITE_FOR_PRINT_FOLDER_ID=
VITE_ORNS_LOGO_ID=
