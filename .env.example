# GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth Client ID
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Your Google Cloud Console OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# AUCTION_ITEMS_SPREADSHEET_ID: Spreadsheet ID for items database
AUCTION_ITEMS_SPREADSHEET_ID=

# AUCTION_TICKETS_SPREADSHEET_ID: Spreadsheet ID for tickets/bidders
AUCTION_TICKETS_SPREADSHEET_ID=

# BID_MANAGEMENT_SPREADSHEET_ID: Spreadsheet ID for active bid management
BID_MANAGEMENT_SPREADSHEET_ID=

# SESSION_SECRET: A secret key for session management
SESSION_SECRET=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# GOOGLE_SCRIPT_ID: The ID of your Google Apps Script project (from Project Settings)
GOOGLE_SCRIPT_ID=
