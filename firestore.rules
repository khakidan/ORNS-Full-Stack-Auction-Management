rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 0: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOrnsUser() {
      return isSignedIn() && 
             request.auth.token.email_verified == true && 
             request.auth.token.email.matches('.*@orns\\.org$');
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to validate Config object
    function isValidConfig(data) {
      return data.keys().hasAll([
        'auctionItemsSpreadsheetId',
        'auctionTicketsSpreadsheetId',
        'bidManagementSpreadsheetId',
        'bidderNumbersSheet',
        'auctionItemsSheet',
        'bidManagementSheet',
        'receiptFolderId',
        'forPrintFolderId',
        'ornsLogoId',
        'ticketPrice',
        'auctionItemsScriptId',
        'auctionTicketsScriptId',
        'bidManagementScriptId',
        'bugReportsSpreadsheetId',
        'bugReportsFolderId',
        'updatedAt',
        'updatedBy'
      ]) &&
      data.keys().size() == 17 && // Strict key count
      data.auctionItemsSpreadsheetId is string &&
      data.auctionItemsSpreadsheetId.size() <= 256 &&
      data.auctionTicketsSpreadsheetId is string &&
      data.auctionTicketsSpreadsheetId.size() <= 256 &&
      data.bidManagementSpreadsheetId is string &&
      data.bidManagementSpreadsheetId.size() <= 256 &&
      data.bidderNumbersSheet is string &&
      data.bidderNumbersSheet.size() <= 128 &&
      data.auctionItemsSheet is string &&
      data.auctionItemsSheet.size() <= 128 &&
      data.bidManagementSheet is string &&
      data.bidManagementSheet.size() <= 128 &&
      data.receiptFolderId is string &&
      data.receiptFolderId.size() <= 256 &&
      data.forPrintFolderId is string &&
      data.forPrintFolderId.size() <= 256 &&
      data.ornsLogoId is string &&
      data.ornsLogoId.size() <= 256 &&
      data.ticketPrice is string &&
      data.ticketPrice.size() <= 10 &&
      data.auctionItemsScriptId is string &&
      data.auctionItemsScriptId.size() <= 256 &&
      data.auctionTicketsScriptId is string &&
      data.auctionTicketsScriptId.size() <= 256 &&
      data.bidManagementScriptId is string &&
      data.bidManagementScriptId.size() <= 256 &&
      data.bugReportsSpreadsheetId is string &&
      data.bugReportsSpreadsheetId.size() <= 256 &&
      data.bugReportsFolderId is string &&
      data.bugReportsFolderId.size() <= 256 &&
      data.updatedAt is timestamp &&
      data.updatedBy is string && data.updatedBy.matches('.*@orns\\.org$');
    }

    match /settings/{docId} {
      allow read: if isOrnsUser();
      allow create: if isOrnsUser() && isValidId(docId) && isValidConfig(incoming());
      allow update: if isOrnsUser() && isValidId(docId) && isValidConfig(incoming()) && (
        // Action: Update Config (allow changing any valid config field)
        incoming().diff(existing()).affectedKeys().hasOnly([
          'auctionItemsSpreadsheetId',
          'auctionTicketsSpreadsheetId',
          'bidManagementSpreadsheetId',
          'bidderNumbersSheet',
          'auctionItemsSheet',
          'bidManagementSheet',
          'receiptFolderId',
          'forPrintFolderId',
          'ornsLogoId',
          'ticketPrice',
          'auctionItemsScriptId',
          'auctionTicketsScriptId',
          'bidManagementScriptId',
          'bugReportsSpreadsheetId',
          'bugReportsFolderId',
          'updatedAt',
          'updatedBy'
        ])
      );
      allow delete: if false; // Config should not be deleted by client
    }
  }
}
