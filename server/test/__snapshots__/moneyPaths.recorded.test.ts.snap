exports[`registerWalkInBidder - recorded calls > adds the bidder, their grid columns (growing the grid), formatting, and the ticket row 1`] = `
[
  [
    "get-meta",
    "tix",
  ],
  [
    "get",
    "tix",
    "'tickets'!A1",
  ],
  [
    "get-meta",
    "bm",
  ],
  [
    "get",
    "bm",
    "'Bidder-Numbers'!A:A",
  ],
  [
    "get",
    "bm",
    "'Bid-Management'!1:5",
  ],
  [
    "batchUpdate",
    "bm",
    [
      {
        "appendDimension": {
          "dimension": "COLUMNS",
          "length": 2,
          "sheetId": 2,
        },
      },
    ],
  ],
  [
    "get",
    "bm",
    "'Bidder-Numbers'!A1",
  ],
  [
    "get",
    "bm",
    "'Bid-Management'!E1:F4",
  ],
  [
    "append",
    "bm",
    "'Bidder-Numbers'!A:H",
    [
      [
        103,
        "Dee",
        "Moore",
        "dee@x.org",
        true,
        false,
        false,
        false,
      ],
    ],
  ],
  [
    "update",
    "bm",
    "'Bid-Management'!E1:F4",
    [
      [
        103,
        "",
      ],
      [
        "Dee",
        "Moore",
      ],
      [
        "Item #:",
        "Price:",
      ],
      [
        "1701",
        40,
      ],
    ],
  ],
  [
    "batchUpdate",
    "bm",
    [
      {
        "mergeCells": {
          "mergeType": "MERGE_ALL",
          "range": {
            "endColumnIndex": 6,
            "endRowIndex": 1,
            "sheetId": 2,
            "startColumnIndex": 4,
            "startRowIndex": 0,
          },
        },
      },
      {
        "repeatCell": {
          "cell": {
            "userEnteredFormat": {
              "horizontalAlignment": "CENTER",
            },
          },
          "fields": "userEnteredFormat.horizontalAlignment",
          "range": {
            "endColumnIndex": 6,
            "endRowIndex": 1,
            "sheetId": 2,
            "startColumnIndex": 4,
            "startRowIndex": 0,
          },
        },
      },
      {
        "repeatCell": {
          "cell": {
            "userEnteredFormat": {
              "textFormat": {
                "bold": true,
              },
            },
          },
          "fields": "userEnteredFormat.textFormat.bold",
          "range": {
            "endColumnIndex": 6,
            "endRowIndex": 2,
            "sheetId": 2,
            "startColumnIndex": 4,
            "startRowIndex": 1,
          },
        },
      },
    ],
  ],
  [
    "get",
    "tix",
    "'tickets'!A1",
  ],
  [
    "append",
    "tix",
    "'tickets'!A:V",
    [
      [
        "dee",
        "MOORE",
        " dee@x.org ",
        "",
        "1",
        "FALSE",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "Auction Checkout",
        "Pending",
        "$40",
      ],
    ],
  ],
]
`;

