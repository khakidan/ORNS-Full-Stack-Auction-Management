    ],
  ],
]
`;

exports[`recordWinningBid - recorded calls > also creates the Follow-Up tab and adds a row for a bidder who already checked out 1`] = `
[
  [
    "get",
    "bm",
    "'Bidder-Numbers'!A:G",
  ],
  [
    "get",
    "bm",
    "'Bid-Management'!1:300",
  ],
  [
    "get-meta",
    "bm",
  ],
  [
    "batchUpdate",
    "bm",
    [
      {
        "addSheet": {
          "properties": {
            "title": "Follow-Up",
          },
        },
      },
    ],
  ],
  [
    "update",
    "bm",
    "'Follow-Up'!A1:C1",
    [
      [
        "Bidder ID",
        "Item ID",
        "Amount",
      ],
    ],
  ],
  [
    "get",
    "bm",
    "'Bid-Management'!C4:D4",
  ],
  [
    "get",
    "bm",
    "'Follow-Up'!A1",
  ],
  [
    "update",
    "bm",
    "'Bid-Management'!C4:D4",
    [
      [
        "803",
        20,
      ],
    ],
  ],
  [
    "append",
    "bm",
    "'Follow-Up'!A:C",
    [
      [
        "102",
        "803",
        20,
      ],
    ],
  ],
]
`;

